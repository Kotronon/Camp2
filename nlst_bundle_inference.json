{
    "dataset_dir": "../../../NLST/corrupted_imagesTr",
    "output_dir": "../../../nlst_detection_outputs",
    "output_filename": "nlst_lung_nodule_corrupted_predictions.json",
    "nlst_start_case": 0,
    "nlst_max_cases": 1,
    "checkpointloader": {
        "_target_": "CheckpointLoader",
        "load_path": "$@bundle_root + '/models/model_cpu.pt'",
        "load_dict": {
            "model": "@network"
        },
        "map_location": "@device"
    },
    "test_datalist": "$[{'image': x} for x in sorted(glob.glob(@dataset_dir + '/*.nii.gz'))[@nlst_start_case:@nlst_start_case + @nlst_max_cases]]",
    "dataloader": {
        "_target_": "DataLoader",
        "dataset": "@dataset",
        "batch_size": 1,
        "shuffle": false,
        "num_workers": 0,
        "collate_fn": "$monai.data.utils.no_collation"
    }
}
